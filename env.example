# 生产/现场用环境变量模板（请复制为 .env，并替换所有 change_me_*）
#
# 安全基线：
# - 不要把 .env 提交到仓库（已在 .gitignore）
# - MQTT 账号按服务拆分 + ACL 最小权限（infra/mosquitto/acl）
# - 建议启用 MQTT_TLS=true，并在 mosquitto_secrets:/mosquitto/secret/certs 提供证书

# ==================== 对外端口（宿主机映射） ====================
EDGE_API_PORT=8000
EDGE_MONITOR_PORT=8080
LICENSE_SERVICE_PORT=8004
# 默认仅绑定 127.0.0.1（P0-N1 audit 2026-05-15）：edge-api 持有 license-install 等高危端点，
# license-service 持有签名验证；不应直接暴露到 LAN。生产若真有外部访问需求，由前置
# Caddy/Traefik 反代，并显式把这里设为 0.0.0.0。
EDGE_API_BIND_ADDR=127.0.0.1
LICENSE_SERVICE_BIND_ADDR=127.0.0.1
# edge-daq 健康端口（仅绑定 127.0.0.1，用于本机探针与 OTA /ready 校验）
# 注意：edge-monitor 默认占用 8080，因此这里建议使用 8082
EDGE_DAQ_HEALTH_PORT=8082

# ==================== PostgreSQL ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=edge_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=edge_db

# ==================== InfluxDB 2.x ====================
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_ORG=edge-org
INFLUXDB_BUCKET=industrial-data
INFLUXDB_TOKEN=change_me_influx_token

# ==================== MQTT（Mosquitto） ====================
MQTT_BROKER=mosquitto
# TLS=false -> 1883；TLS=true -> 8883（需证书）
MQTT_TLS=false
MQTT_PORT=1883

# 按服务拆分账号（最小权限）
MQTT_USER_EDGE_API=edge_api
MQTT_PASSWORD_EDGE_API=change_me_mqtt_edge_api
MQTT_USER_EDGE_DAQ=edge_daq
MQTT_PASSWORD_EDGE_DAQ=change_me_mqtt_edge_daq
MQTT_USER_AI_SOFTSENSOR=ai_softsensor
MQTT_PASSWORD_AI_SOFTSENSOR=change_me_mqtt_ai_softsensor
MQTT_USER_EDGE_MONITOR=edge_monitor
MQTT_PASSWORD_EDGE_MONITOR=change_me_mqtt_edge_monitor

# 预留：ai-ctrl-optimizer 当前未使用 MQTT
MQTT_USER_AI_CTRL_OPTIMIZER=ai_ctrl_optimizer
MQTT_PASSWORD_AI_CTRL_OPTIMIZER=change_me_mqtt_ai_ctrl_optimizer

# 若需重建 mosquitto password_file（会覆盖旧文件）：
# MQTT_INIT_FORCE=true

# ==================== PLC（生产必须对齐现场） ====================
# 推荐（工业交付）：PLC 与 edge 同网段/同一路由时，只需要配置应用层参数即可（不改网卡 IP/网关）
# - 云端下发（推荐）：cloud-ops 通过 edge-api 写入 ./configs-runtime/plc.yaml，并重启 edge-daq 生效
# - 读取优先级：configs-runtime/plc.yaml > env 变量
PLC_HOST=192.168.1.100
PLC_PORT=2022
PLC_SLAVE_ID=1
MODBUS_FRAMER=rtu
PLC_CONNECT_TIMEOUT=5
PLC_SCAN_INTERVAL=1

# ==================== 控制闭环签名（edge-api 与 edge-daq 必须一致） ====================
CONTROL_SIGNATURE_SECRET=change_me_control_signature_secret

# ==================== AI 模型路径（容器内） ====================
AI_MODEL_PATH=/app/models/model.onnx

# ==================== 授权服务（按需） ====================
LICENSE_CHECK_ENABLED=true
LICENSE_EXPIRY_DAYS=365
# 出厂预激活后由 bootstrap 写入并挂载给 license-service
LICENSE_FILE_PATH=/etc/drycontroller/license/license.json
LICENSE_PUBLIC_KEY_PATH=/etc/drycontroller/keys/license.pub
# bootstrap 会写入宿主机 /etc/machine-id，用于避免容器内 machine-id 与宿主机不一致
LICENSE_MACHINE_ID=

# ==================== 日志 ====================
LOG_LEVEL=INFO

# ==================== 跨域（生产建议显式收敛） ====================
# 允许跨域来源（JSON 数组或逗号分隔），例如：
# CORS_ORIGINS=["https://drycontroller.local"]
# CORS_ORIGINS=https://drycontroller.local,https://ops.local

# ==================== edge-api/edge-monitor 鉴权 ====================
API_KEY_HEADER=X-API-Key
# 支持 JSON 数组或逗号分隔
CONTROL_API_KEYS=["change_me_control_api_key"]
ADMIN_API_KEYS=["change_me_admin_api_key"]
# edge-monitor 高危接口（未配置则复用 ADMIN_API_KEYS）
MONITOR_OPS_API_KEYS=change_me_admin_api_key

# ==================== OTA Agent（可选，profile=ota） ====================
# 若启用 edge-ota-agent，默认复用 ADMIN_API_KEYS；
# 也可以单独配置（JSON 数组或逗号分隔）
# OTA_AGENT_API_KEYS=["change_me_ota_api_key"]

# 关键：让 OTA agent 以“同一个 compose project”操作现有容器，避免 project 不一致导致 container_name 冲突
COMPOSE_PROJECT_NAME=drycontroller-edge

# 关键：OTA agent 在容器内执行 compose 时，必须使用“宿主机真实存在的绝对路径”作为项目目录
# 默认宿主机安装路径为 /opt/Drycontroller-edge
OTA_WORK_DIR=/opt/Drycontroller-edge

# cosign 公钥（ota-update.sh online 模式拉镜像后用此公钥 verify 签名）
# 查找顺序：$OTA_COSIGN_PUBKEY_HOST_PATH -> /etc/drycontroller/keys/cosign.pub -> $REPO_ROOT/configs/keys/cosign.pub
# 生产装机：cosign.pub 由 bootstrap.sh 从 U 盘落到 /etc/drycontroller/keys/cosign.pub
# dev 环境：直接用仓库内置 configs/keys/cosign.pub，无需配此变量
# OTA_COSIGN_PUBKEY_HOST_PATH=/etc/drycontroller/keys/cosign.pub

# cosign verify 只对来自此 registry 的 image 生效（项目自家 registry）；
# 第三方 base image（postgres / prometheus / mosquitto 等）不在此处验签——
# 它们靠 docker daemon DCT / 上游签名机制保护。
# 生产强烈推荐配置；不配则 verify 会试图签 *所有* image 然后失败。
OTA_TRUSTED_REGISTRY=git.example.com

# 联调/演示环境：若 PLC 不在线导致 edge-daq /ready 长期 503，可临时跳过
# 注意：生产不建议跳过
OTA_SKIP_READY=false
OTA_SKIP_SMOKE=false

# 联调/弱网环境：若无法访问 Docker Hub，可临时跳过 compose pull（仅做 up -d）
OTA_SKIP_PULL=false
