# 说明
# - 本文件内容是“可直接作为 .env 使用”的模板（纯 KEY=VALUE + 注释）。
# - 使用方法：cp .env.example .env && vim .env
# - 注意：.env 已在 .gitignore 中忽略，请勿提交；生产环境务必替换所有默认口令/Token。
#
# macOS/Windows 提示：
# - docker-compose.yml 中 license-service 需要 USB 设备映射与 privileged，本地开发通常不可用；
#   如启动失败，可先跳过该服务（详见 QUICKSTART.md）。

# ==================== 对外端口 ====================
EDGE_API_PORT=8000
EDGE_MONITOR_PORT=8080
LICENSE_SERVICE_PORT=8004

# ==================== PostgreSQL（compose 内部互联：postgres）====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=edge_user
POSTGRES_PASSWORD=edge_password_2025
POSTGRES_DB=edge_db

# ==================== InfluxDB 2.x（compose 内部互联：influxdb）=================
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin_password_2025
INFLUXDB_ORG=edge-org
INFLUXDB_BUCKET=industrial-data
INFLUXDB_TOKEN=influx_token_2025

# ==================== MQTT（compose 内部互联：mosquitto）========================
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=edge_mqtt
# 默认 mosquitto 密码文件需要与该值一致（见 infra/mosquitto/passwords）
MQTT_PASSWORD=mqtt_password_2025

# ==================== PLC（无现场 PLC 时可先保持默认，edge-daq 会重试连接）========
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_SLAVE_ID=1
PLC_SCAN_INTERVAL=1

# ==================== 控制闭环签名密钥（edge-api 与 edge-daq 必须一致）==========
CONTROL_SIGNATURE_SECRET=dev-control-secret

# ==================== AI 模型路径（容器内路径；默认挂载到 /app/models）===========
AI_MODEL_PATH=/app/models/model.onnx

# ==================== 授权（默认启用；仅本地开发排障时才可显式关闭）===========
LICENSE_CHECK_ENABLED=true
LICENSE_EXPIRY_DAYS=365
LICENSE_FILE_PATH=/etc/drycontroller/license/license.json
LICENSE_PUBLIC_KEY_PATH=/etc/drycontroller/keys/license.pub
LICENSE_TRUSTED_PUBLIC_KEY=
LICENSE_SERVICE_BASE=http://license-service:8000

# ==================== 日志 ==============================================
LOG_LEVEL=INFO

# ==================== remote-debug（可选，仅 Linux + 需要远程运维通道时）==========
# TS_LOGIN_SERVER=
# TS_AUTHKEY=
# TS_HOSTNAME=edge-node
# CLOUD_OPS_BASE_URL=
# CLOUD_OPS_ENROLL_TOKEN=
# CLOUD_OPS_ENROLL_TOKEN_HEADER=X-Enroll-Token
# ENROLL_INTERVAL_SEC=60
