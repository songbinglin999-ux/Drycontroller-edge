#!/usr/bin/python3
"""Fixed no-argument entrypoint for the signed release transaction."""

from __future__ import annotations

import json
import sys

from release_engine import ReleaseEngine, ReleaseError


def main() -> int:
    if len(sys.argv) != 1:
        return 64
    try:
        result = ReleaseEngine().apply()
    except ReleaseError as exc:
        print(f"[ota-apply] release failed: {exc}", flush=True)
        return 1
    except Exception as exc:  # noqa: BLE001 - root boundary must fail closed and leave the journal for recovery
        print(f"[ota-apply] unexpected failure: {type(exc).__name__}", flush=True)
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
