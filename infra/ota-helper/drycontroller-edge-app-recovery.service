[Unit]
Description=Recover and start the verified DryController Edge application release
After=docker.service drycontroller-license-transaction-recovery.service
Requires=docker.service drycontroller-license-transaction-recovery.service
Before=drycontroller-ota-helper.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/drycontroller/start-active-release
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/drycontroller-ota /var/log/drycontroller-ota /run/docker.sock

[Install]
WantedBy=multi-user.target
