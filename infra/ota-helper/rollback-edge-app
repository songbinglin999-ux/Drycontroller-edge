#!/usr/bin/python3
from __future__ import annotations

import argparse
import json

from edge_app_release import ReleaseEngine, ReleaseError


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--operation-id", required=True)
    parser.add_argument("--expected-active-release-id", required=True)
    parser.add_argument("--target-release-id", required=True)
    args = parser.parse_args()
    try:
        result = ReleaseEngine().rollback(
            operation_id=args.operation_id,
            expected_active_release_id=args.expected_active_release_id,
            target_release_id=args.target_release_id,
        )
    except ReleaseError as exc:
        print(f"[rollback-edge-app] failed: {exc}", flush=True)
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
