#!/usr/bin/python3
from __future__ import annotations

import json

from edge_app_release import ReleaseEngine, ReleaseError


try:
    print(json.dumps(ReleaseEngine().rollback(), sort_keys=True))
except ReleaseError as exc:
    print(f"[rollback-edge-app] failed: {exc}", flush=True)
    raise SystemExit(1) from exc
