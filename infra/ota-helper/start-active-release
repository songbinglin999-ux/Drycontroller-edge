#!/usr/bin/python3
"""Start only the signed active release with registry access disabled."""

from __future__ import annotations

import json
import sys

sys.dont_write_bytecode = True

from release_engine import ReleaseEngine, ReleaseError


def main() -> int:
    lock_descriptor: int | None = None
    if len(sys.argv) == 3 and sys.argv[1] == "--lock-fd":
        try:
            lock_descriptor = int(sys.argv[2])
        except ValueError:
            return 64
    elif len(sys.argv) != 1:
        return 64
    try:
        engine = ReleaseEngine()
        result = (
            engine.start_active()
            if lock_descriptor is None
            else engine.start_active_with_lock_fd(lock_descriptor)
        )
    except ReleaseError as exc:
        print(f"[start-active-release] failed: {exc}", flush=True)
        return 1
    except Exception as exc:  # noqa: BLE001 - root startup boundary must fail closed
        print(f"[start-active-release] unexpected failure: {type(exc).__name__}", flush=True)
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
