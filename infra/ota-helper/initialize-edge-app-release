#!/usr/bin/python3
"""Initialize the one trusted active release before the OTA helper starts."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from edge_app_release import ReleaseEngine, ReleaseError


_MAX_SEED_BYTES = 64 * 1024


def main() -> int:
    if len(sys.argv) == 2:
        path = Path(sys.argv[1])
    else:
        return 64
    try:
        if path.stat().st_size > _MAX_SEED_BYTES:
            raise ReleaseError("initial release seed too large")
        seed = json.loads(path.read_text(encoding="utf-8"))
        result = ReleaseEngine().initialize_active(seed)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ReleaseError) as exc:
        print(f"[initialize-active-release] failed: {exc}", flush=True)
        return 1
    except Exception as exc:  # noqa: BLE001 - root install boundary must fail closed
        print(f"[initialize-active-release] unexpected failure: {type(exc).__name__}", flush=True)
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
