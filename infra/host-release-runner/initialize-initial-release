#!/usr/bin/python3
"""Initialize the one signed H1/T1/S1 tuple on a blank Edge host."""

from __future__ import annotations

import json
import sys
from pathlib import Path

from host_release_engine import HostReleaseEngine, HostReleaseError


MAX_SEED_BYTES = 1024 * 1024


def _seed(path: Path) -> object:
    if not path.is_file() or path.stat().st_size > MAX_SEED_BYTES:
        raise HostReleaseError("initial release seed missing or too large")
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    if len(sys.argv) != 5:
        return 64
    host_seed_path, software_seed_path, host_archive, software_archive = map(
        Path, sys.argv[1:]
    )
    try:
        if not host_archive.is_file() or not software_archive.is_file():
            raise HostReleaseError("initial release image archive missing")
        result = HostReleaseEngine().initialize_initial_pair(
            host_seed=_seed(host_seed_path),
            software_seed=_seed(software_seed_path),
            host_image_archive=host_archive,
            software_image_archive=software_archive,
        )
    except (
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
        HostReleaseError,
    ) as exc:
        print(f"[initialize-initial-release] failed: {exc}", flush=True)
        return 1
    except Exception as exc:  # noqa: BLE001 - root install boundary must fail closed
        print(
            f"[initialize-initial-release] unexpected failure: {type(exc).__name__}",
            flush=True,
        )
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
