#!/usr/bin/python3
"""Fixed no-argument HostRelease transaction entrypoint."""

from __future__ import annotations

import json
import sys

from host_release_engine import HostReleaseEngine, HostReleaseError


def main() -> int:
    if len(sys.argv) != 1:
        return 64
    try:
        result = HostReleaseEngine().apply()
    except HostReleaseError as exc:
        print(f"[host-release-apply] failed: {exc}", flush=True)
        return 1
    except Exception as exc:  # noqa: BLE001 - immutable root boundary must fail closed
        print(f"[host-release-apply] unexpected failure: {type(exc).__name__}", flush=True)
        return 1
    print(json.dumps(result, ensure_ascii=False, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
