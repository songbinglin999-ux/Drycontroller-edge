[Unit]
Description=DryController host-level Tailscale
Documentation=https://tailscale.com/kb/
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=notify
ExecStart=/usr/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock
Restart=always
RestartSec=5
WatchdogSec=60

# Hardening
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
