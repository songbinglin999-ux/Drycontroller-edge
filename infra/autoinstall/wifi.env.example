# Copy this file to wifi.env and place it at the root of the Ubuntu installer
# media when the factory/install area only has WiFi.
#
# Keep wifi.env out of git. It contains the WiFi password.

WIFI_SSID=Factory-WiFi
WIFI_PASSWORD=replace-with-password

# Optional: pin to a specific wireless interface if automatic selection fails.
# Common names: wlan0, wlp2s0, wlp3s0
# WIFI_INTERFACE=wlan0
