#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Asia/Shanghai

  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
      all-eth:
        match:
          name: "eth*"
        dhcp4: true
        optional: true

  # Production media should replace the password hash before use.
  # Generate a hash:
  #   openssl passwd -6
  identity:
    hostname: drycontroller-edge
    username: dryops
    password: "$6$REPLACE_WITH_SHA512_CRYPT_HASH"

  ssh:
    install-server: true
    allow-pw: true

  early-commands:
    - test -d /cdrom/dists || (echo "missing /cdrom/dists; OS Installer USB must keep the Ubuntu ISO apt repository at the media root" >&2; exit 1)
    - test -f /cdrom/drycontroller-apt/Packages || (echo "missing /cdrom/drycontroller-apt/Packages; build and copy the offline apt repo before booting the OS Installer USB" >&2; exit 1)
    - |
      python3 - <<'PY'
      from pathlib import Path

      def install_media_parent():
          mounts = Path("/proc/mounts").read_text(encoding="utf-8").splitlines()
          source = ""
          for line in mounts:
              parts = line.split()
              if len(parts) >= 2 and parts[1] == "/cdrom":
                  source = parts[0]
                  break
          if not source.startswith("/dev/"):
              return ""
          name = Path(source).name
          sys_path = Path("/sys/class/block") / name
          if not sys_path.exists():
              return name
          parent = sys_path.resolve().parent.name
          return parent if parent != "block" else name

      skip = {install_media_parent()}
      candidates = []
      for entry in Path("/sys/block").iterdir():
          name = entry.name
          if (
              name in skip
              or name.startswith(("loop", "ram", "zram", "fd", "sr", "dm-"))
          ):
              continue
          removable = (entry / "removable").read_text(encoding="utf-8").strip()
          if removable == "1":
              continue
          size = int((entry / "size").read_text(encoding="utf-8").strip())
          candidates.append((size, name))

      if not candidates:
          raise SystemExit("no non-removable install disk found")

      _, disk = max(candidates)
      config = Path("/autoinstall.yaml")
      text = config.read_text(encoding="utf-8")
      try:
          import yaml

          data = yaml.safe_load(text)
          for item in data["autoinstall"]["storage"]["config"]:
              if item.get("id") == "install-disk":
                  item["match"] = {"path": f"/dev/{disk}"}
                  break
          else:
              raise SystemExit("install-disk config not found")
          config.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")
      except ModuleNotFoundError:
          old = "        match:\n          size: largest\n"
          new = f"        match:\n          path: /dev/{disk}\n"
          if old not in text:
              raise SystemExit("install-disk match block not found")
          config.write_text(text.replace(old, new), encoding="utf-8")
      print(f"DryController autoinstall target disk: /dev/{disk}")
      PY

  storage:
    swap:
      size: 0
    config:
      - type: disk
        id: install-disk
        match:
          size: largest
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: true
      - type: partition
        id: bios-grub-partition
        device: install-disk
        size: 1M
        flag: bios_grub
        wipe: superblock
        preserve: false
      - type: partition
        id: efi-partition
        device: install-disk
        size: 1G
        flag: boot
        wipe: superblock
        preserve: false
      - type: format
        id: efi-format
        volume: efi-partition
        fstype: fat32
        label: EFI
        preserve: false
      - type: mount
        id: efi-mount
        device: efi-format
        path: /boot/efi
      - type: partition
        id: root-partition
        device: install-disk
        size: -1
        wipe: superblock
        preserve: false
      - type: format
        id: root-format
        volume: root-partition
        fstype: ext4
        label: dry-edge-root
        preserve: false
      - type: mount
        id: root-mount
        device: root-format
        path: /

  late-commands:
    - curtin in-target --target=/target -- mkdir -p /opt /var/log
    - mkdir -p /target/opt/drycontroller-apt
    - cp -a /cdrom/drycontroller-apt/. /target/opt/drycontroller-apt/
    - sh -c 'echo "deb [trusted=yes] file:/opt/drycontroller-apt ./" > /target/etc/apt/sources.list && rm -f /target/etc/apt/sources.list.d/ubuntu.sources /target/etc/apt/sources.list.d/drycontroller-offline.list'
    - cp -a /cdrom/drycontroller-edge.tar.gz /target/opt/drycontroller-edge.tar.gz
    - sh -c 'if [ -f /cdrom/wifi.env ]; then cp -a /cdrom/wifi.env /target/opt/drycontroller-wifi.env; chmod 0600 /target/opt/drycontroller-wifi.env; fi'
    - sh -c 'if [ -f /cdrom/tailnet.env ]; then mkdir -p /target/etc/drycontroller; cp -a /cdrom/tailnet.env /target/etc/drycontroller/tailnet.env; chmod 0600 /target/etc/drycontroller/tailnet.env; fi'
    - sh -c 'if [ -f /cdrom/factory-license.json ]; then mkdir -p /target/etc/drycontroller/license /target/var/lib/drycontroller; cp -a /cdrom/factory-license.json /target/etc/drycontroller/license/license.json; cp -a /cdrom/factory-license.json /target/var/lib/drycontroller/factory-license.json; chmod 0600 /target/etc/drycontroller/license/license.json /target/var/lib/drycontroller/factory-license.json; fi'
    - cp -a /cdrom/post-install.sh /target/usr/local/sbin/drycontroller-edge-post-install.sh
    - cp -a /cdrom/drycontroller-edge-post-install.service /target/etc/systemd/system/drycontroller-edge-post-install.service
    - curtin in-target --target=/target -- chmod 0755 /usr/local/sbin/drycontroller-edge-post-install.sh
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable drycontroller-edge-post-install.service
    - curtin in-target --target=/target -- systemctl set-default multi-user.target
    - curtin in-target --target=/target -- sh -c 'echo DryController Edge first boot install is pending > /etc/motd'

  error-commands:
    - mkdir -p /target/var/log/drycontroller-installer-failure || true
    - cp -a /var/log/installer /target/var/log/drycontroller-installer-failure/installer || true
    - sh -c 'journalctl -b > /target/var/log/drycontroller-installer-failure/journal.log' || true

  shutdown: poweroff
