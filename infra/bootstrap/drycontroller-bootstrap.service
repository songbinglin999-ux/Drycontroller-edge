[Unit]
Description=Drycontroller one-time provisioning bootstrap (USB auto-provision)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/drycontroller-bootstrap.sh
TimeoutStartSec=1800
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target


