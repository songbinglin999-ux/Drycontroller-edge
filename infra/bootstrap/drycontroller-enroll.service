[Unit]
Description=Drycontroller host cloud enroll loop
Documentation=file:/opt/Drycontroller-edge/docs/ops/remote-debug-dev.md
Wants=network-online.target drycontroller-tailnet.service
After=network-online.target drycontroller-tailnet.service docker.service
ConditionPathExists=/etc/drycontroller/tailnet.env

[Service]
Type=simple
ExecStart=/usr/local/sbin/drycontroller-host-enroll.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
