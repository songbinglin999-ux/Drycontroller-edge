[Unit]
Description=Drycontroller host tailnet join
Documentation=file:/opt/Drycontroller-edge/docs/ops/remote-debug-dev.md
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/drycontroller-host-tailnet.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
