[Unit]
Description=DryController Tailnet Edge API proxy
Requires=docker.service
After=docker.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/drycontroller/tailnet-edge-api-proxy.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
