[Unit]
Description=DryController live TPM identity observer
After=dev-tpmrm0.device
Before=docker.service drycontroller-license-transaction-recovery.service
Requires=dev-tpmrm0.device

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/opt/drycontroller-identity/venv/bin/python /usr/libexec/drycontroller/observe-tpm-identity.py
RuntimeDirectory=drycontroller-identity
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ReadWritePaths=/run/drycontroller-identity

[Install]
RequiredBy=docker.service
