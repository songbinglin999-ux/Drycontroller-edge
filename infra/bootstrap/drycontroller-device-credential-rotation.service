[Unit]
Description=DryController per-device credential rotation
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/drycontroller/device.json

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/drycontroller-identity
Environment=DRYCONTROLLER_IDENTITY_BACKEND=tpm
EnvironmentFile=-/etc/drycontroller/cloud-ops.env
ExecStart=/opt/drycontroller-identity/venv/bin/python -m identity_service.rotation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/drycontroller-identity /var/lib/drycontroller
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
