[Unit]
Description=DryController sanitized Tailnet observer
After=tailscaled.service drycontroller-tailnet-edge-api.socket
Wants=tailscaled.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/drycontroller/observe-tailnet-status.py
RuntimeDirectory=drycontroller-tailnet-observation
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/drycontroller-tailnet-observation

[Install]
WantedBy=multi-user.target
